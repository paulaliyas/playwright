# Copy to .env (shared) or .env.<env> (per environment: .env.dev, .env.sit, .env.uat, .env.e2e)
# Never commit real values — use Jenkins credentials in CI.

# --- Run options ---
ENV=dev                 # dev | sit | uat | e2e
DOMAIN=                 # blank = all, or establishment,individual,public
BROWSER=chromium        # chromium | firefox | webkit
HEADLESS=true
WORKERS=4

# --- Per-domain credentials (<DOMAIN>_USERNAME / <DOMAIN>_PASSWORD) ---
ESTABLISHMENT_USERNAME=
ESTABLISHMENT_PASSWORD=
INDIVIDUAL_USERNAME=
INDIVIDUAL_PASSWORD=

# --- Optional per-domain URL override (beats environments/<env>.json) ---
# ESTABLISHMENT_BASE_URL=https://...

# --- Oracle test-data DB ---
DB_USER=
DB_PASSWORD=
DB_CONNECT_STRING=host:1521/SERVICE
