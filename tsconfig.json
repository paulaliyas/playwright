{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "baseUrl": ".",
    "paths": {
      "@config/*": ["config/*"],
      "@core/*": ["src/core/*"],
      "@domains/*": ["src/domains/*"]
    },
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "reports"]
}
